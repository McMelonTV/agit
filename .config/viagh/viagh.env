# viagh environment template.
#
# Install as $XDG_CONFIG_HOME/viagh/viagh.env (Linux/macOS: ~/.config/viagh/viagh.env)
# or %AppData%\viagh\viagh.env on Windows, and viagh loads it automatically at
# startup. An explicit path can be set with VIAGH_CONFIG_FILE.
#
# Variables already present in the process environment take precedence over
# the file, and empty values are ignored. Values are literal: no shell
# expansion, command substitution, or variable interpolation is performed, so
# quote values containing spaces (e.g. VIAGH_GIT_NAME='Release Agent').
#
# All variables are optional except the App ID and one private-key form.

# GitHub App ID or client ID used as the JWT issuer.
export VIAGH_APP_ID=

# One of the following private-key forms is required.
# Path to the private-key PEM:
export VIAGH_PRIVATE_KEY=
# Inline private-key PEM:
export VIAGH_PRIVATE_KEY_PEM=
# Base64-encoded private-key PEM:
export VIAGH_PRIVATE_KEY_BASE64=

# Installation selection (optional; inferred from the command otherwise).
# Explicit installation ID:
export VIAGH_INSTALLATION_ID=
# Organization or user installation owner:
export VIAGH_OWNER=
# Repository selector in OWNER/REPO or HOST/OWNER/REPO form:
export VIAGH_REPOSITORY=

# GitHub hostname; defaults to github.com.
export VIAGH_HOST=
# REST API base URL; must be absolute HTTPS.
export VIAGH_API_URL=
# REST API version; defaults to 2026-03-10.
export VIAGH_API_VERSION=

# Token cache directory:
export VIAGH_CACHE_DIR=
# Disable token caching when truthy:
export VIAGH_NO_CACHE=
# Refresh threshold, such as 5m:
export VIAGH_REFRESH_BEFORE=
# API and broker timeout, such as 30s:
export VIAGH_HTTP_TIMEOUT=

# Underlying executables (recommended for deterministic environments).
export VIAGH_REAL_GH=
export VIAGH_REAL_GIT=

# Git authorship: bot, configured, or both; defaults to bot.
export VIAGH_GIT_AUTHORSHIP=
# Name and email for configured or both authorship:
export VIAGH_GIT_NAME=
export VIAGH_GIT_EMAIL=
# Override existing Git identity when true; defaults to true.
export VIAGH_OVERRIDE_GIT_IDENTITY=
